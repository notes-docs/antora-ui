<main class="docs-main{{#if (eq page.layout '404')}} is-not-found{{/if}}{{#if page.home}} is-home{{/if}}">
  <div class="docs-main-inner">
    {{#unless (eq page.layout '404')}}
      {{> breadcrumbs}}
    {{/unless}}
    {{#if (eq page.layout '404')}}
      {{> article-404}}
    {{else}}
      {{> article}}
      {{> pagination}}
    {{/if}}
  </div>
</main>
