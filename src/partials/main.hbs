<main class="docs-main{{#if (eq page.layout '404')}} is-not-found{{/if}}">
  <div class="docs-main-inner">
    {{#unless (eq page.layout '404')}}
      {{> breadcrumbs}}
    {{/unless}}
    {{#if (eq page.layout '404')}}
      {{> article-404}}
    {{else}}
      {{> article}}
      {{> pagination}}
    {{/if}}
  </div>
  {{#unless (eq page.layout '404')}}
    <aside class="docs-toc">
      {{> toc}}
    </aside>
  {{/unless}}
</main>
