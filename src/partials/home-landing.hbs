<article class="books-home">
  {{#with (booksHomeSections site.components)}}
    <div class="books-home-summary">
      <h2 class="books-home-summary-title">全部手册</h2>
      <span class="books-home-summary-count">{{this.length}} 本</span>
    </div>
    <div class="books-grid">
      {{#each this}}
        <a class="book-card" href="{{#if (eq urlType 'internal')}}{{{relativize href}}}{{else}}{{href}}{{/if}}">
          <span class="book-card-cover accent-{{accent}}">
            <span class="book-card-cover-label">{{coverText}}</span>
          </span>
          <span class="book-card-body">
            <span class="book-card-title">{{title}}</span>
            <span class="book-card-description">{{description}}</span>
            <span class="book-card-tags">
              {{#each tags}}
                <span class="book-card-tag">{{this}}</span>
              {{/each}}
            </span>
          </span>
        </a>
      {{/each}}
    </div>
  {{else}}
    <div class="books-home-empty">
      <p>当前导航里还没有可展示的书籍页面。</p>
    </div>
  {{/with}}
</article>
