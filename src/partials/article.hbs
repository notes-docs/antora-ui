{{#if page.home}}
  {{> home-landing}}
{{else}}
  <article class="doc sl-markdown-content">
    <header class="doc-article-header" data-slot="doc-title">
      <div class="doc-article-title-row" data-slot="doc-title-header">
        {{#with page.title}}
          <h1 class="page">{{{this}}}</h1>
        {{/with}}
      </div>
      {{#with page.attributes.description}}
        <p class="doc-lede" slot="doc-title-description">{{this}}</p>
      {{/with}}
    </header>
    <div class="doc-content">
      {{{page.contents}}}
    </div>
  </article>
{{/if}}
