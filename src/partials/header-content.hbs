<header class="header site-header">
  <nav class="navbar site-header-container container-wrapper">
    <div class="site-header-left">
      <button class="nav-toggle mobile-nav-toggle" type="button" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <a class="site-brand" href="{{{or site.url (or siteRootUrl siteRootPath)}}}">
        <img id="navbar-logo" src="{{{uiRootPath}}}/img/logo.svg" alt="{{site.title}}">
        <span>{{site.title}}</span>
      </a>
      <nav class="top-nav" aria-label="Primary">
        {{#each site.components}}
          <a class="top-nav-link{{#if (eq ../page.component.name @key)}} active{{/if}}" href="{{#if this.latest.url}}{{{relativize this.latest.url}}}{{else if this.url}}{{{relativize this.url}}}{{else}}{{{../siteRootPath}}}{{/if}}">
            {{this.title}}
          </a>
        {{/each}}
      </nav>
    </div>
    <div class="site-header-right">
      <button class="search-placeholder" type="button" aria-label="Search">
        <span>Search</span>
        <kbd>Ctrl K</kbd>
      </button>
      <button class="theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
        <span class="theme-toggle-icon theme-light">☀</span>
        <span class="theme-toggle-icon theme-dark">☾</span>
      </button>
    </div>
  </nav>
</header>
