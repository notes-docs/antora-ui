<div class="body">
  <div class="site-shell{{#if page.home}} site-shell-home{{/if}}">
    {{#unless (or (eq page.layout '404') page.home)}}
      <aside class="docs-sidebar nav-container">
        {{> nav}}
      </aside>
    {{/unless}}
    {{> main}}
    {{#unless (or (eq page.layout '404') page.home)}}
      <aside class="docs-toc">
        {{> toc}}
      </aside>
    {{/unless}}
  </div>
</div>
